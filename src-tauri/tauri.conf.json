{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "J.H Editor",
  "mainBinaryName": "J.H Editor",
  "version": "0.1.3",
  "identifier": "io.github.pei-jz.jheditor",
  "build": {
    "devUrl": "http://localhost:1425",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "J.H Editor",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-elem": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost https://asset.localhost",
        "media-src": "'self' data: blob: asset: http://asset.localhost https://asset.localhost",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost ws: wss: http: https: asset: http://asset.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "../LICENSE",
    "publisher": "J.H Editor Team",
    "copyright": "Copyright (c) 2026 J.H Editor Team",
    "resources": [
      "../LICENSE",
      "../THIRD-PARTY-NOTICES.md"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/hooks.nsh",
        "installMode": "both"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/pei-jz/jh-editor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDNTc4QzBDOTUwRDIxMTIKUldRU0lRMlZESXhYUENtN1NTcjgwWVV6RGRiQ3VNUkdqc0tuRDJwNGFkbXRqNFNmdlpmKy9uUSsK"
    }
  }
}
